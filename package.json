{
  "name": "hype-detector",
  "version": "0.2.1",
  "description": "Separate evidence from marketing: analyze the claims in a product listing with your own LLM key or a local model.",
  "license": "MIT",
  "author": "Tilan Ukwatta",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "zip": "npm run build && node scripts/package.mjs",
    "build:store": "VITE_STORE_BUILD=1 npm run build",
    "zip:store": "VITE_STORE_BUILD=1 npm run zip",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.0"
  }
}
